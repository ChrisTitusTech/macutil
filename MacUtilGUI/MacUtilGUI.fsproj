<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!--
      Single-file and trimming are OPT-IN (packaging/build_app.sh does not use them).

      A self-contained *single-file* publish extracts the native libraries at
      startup into ~/.net/<app>/<hash>/. On Apple Silicon macOS then refuses to
      load them, because the extracted copy is signed ad-hoc while the host
      process is signed with a Developer ID (and hardened runtime):
        DllNotFoundException: libSkiaSharp ... different Team IDs
      which makes every published build crash on M1/M2/M3/M4.

      Trimming is risky here as well: Avalonia, F# and Tomlyn resolve types by
      reflection, so the linker can silently drop types the app needs at runtime.

      Keep the defaults portable; enable the old behaviour explicitly with
        dotnet publish -p:MacUtilSingleFile=true -p:MacUtilTrim=true
    -->
    <PublishSingleFile Condition="'$(MacUtilSingleFile)' == 'true'">true</PublishSingleFile>
    <PublishTrimmed Condition="'$(MacUtilTrim)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(MacUtilTrim)' == 'true'">link</TrimMode>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(MacUtilSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(MacUtilSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(MacUtilSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun Condition="'$(MacUtilTrim)' == 'true'">true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    
    <!-- macOS specific properties -->
    <UseAppHost>true</UseAppHost>
    <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
    
    <!-- macOS Bundle Properties -->
    <CFBundleName>MacUtil</CFBundleName>
    <CFBundleDisplayName>MacUtil GUI</CFBundleDisplayName>
    <CFBundleIdentifier>com.macutil.gui</CFBundleIdentifier>
    <CFBundleVersion>0.2.1</CFBundleVersion>
    <CFBundleShortVersionString>0.2.1</CFBundleShortVersionString>
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <CFBundleSignature>????</CFBundleSignature>
    <CFBundleExecutable>MacUtilGUI</CFBundleExecutable>
    <CFBundleIconFile>MacUtilGUI.icns</CFBundleIconFile>
    <NSPrincipalClass>NSApplication</NSPrincipalClass>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Compile Include="Models\ScriptInfo.fs" />
    <Compile Include="Models\ScriptCategory.fs" />
    <Compile Include="Services\ScriptService.fs" />
    <Compile Include="ViewModels\ViewModelBase.fs" />
    <Compile Include="ViewModels\MainWindowViewModel.fs" />
    <Compile Include="Views\MainWindow.axaml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.0.10" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <PackageReference Include="Dotnet.Bundle" Version="*" />
  </ItemGroup>

  <!-- Trim-friendly settings for Avalonia -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Include scripts as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="../scripts/**/*.sh" />
    <EmbeddedResource Include="../scripts/**/*.toml" />
  </ItemGroup>

</Project>
